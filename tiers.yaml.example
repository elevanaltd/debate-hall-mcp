# =============================================================================
# CUSTOM PROMPTS - Use your own agent prompts
# =============================================================================

# Prompt resolution order:
#   1. Absolute path: /path/to/prompt.oct.md
#   2. Relative path: ./prompts/prompt.oct.md
#   3. Named variant: "security" -> {role}-security.oct.md
#      Searched in: ./prompts/ then ~/.debate-hall/prompts/

# security:
#   wind:
#     provider: openrouter
#     model: anthropic/claude-sonnet-4.5
#     prompt_file: security  # -> wind-security.oct.md
