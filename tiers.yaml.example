# Debate Hall MCP - Tier Configuration
#
# QUICK START:
#   1. Copy this file:  cp tiers.yaml.example tiers.yaml
#   2. Set your API key: export OPENROUTER_API_KEY=your-key
#   3. Run a debate:    run_debate(topic="Your topic", tier="standard")
#
# Resolution order: env var > ./tiers.yaml > ~/.debate-hall/tiers.yaml
#
# PROVIDERS:
#   openrouter - API-based (requires OPENROUTER_API_KEY)
#   cli        - External CLIs (requires claude/codex/gemini installed)
#
# For OpenRouter models: https://openrouter.ai/models
#
# =============================================================================
# TERMINOLOGY: Position vs Cognition vs Role
# =============================================================================
#
# This configuration file uses three distinct identity concepts:
#
#   POSITION (wind/wall/door keys):
#     The structural debate position - determines turn order.
#     Wind explores, Wall validates, Door synthesizes.
#
#   COGNITION (PATHOS/ETHOS/LOGOS):
#     The thinking mode - mapped to positions but conceptually distinct.
#     PATHOS=divergent (Wind), ETHOS=convergent (Wall), LOGOS=integrative (Door).
#
#   ROLE (the `role` field):
#     The agent's expertise identity - provides domain specialization.
#     Examples: wind-agent, wall-agent, door-agent (basic)
#               ideator, critical-engineer, synthesizer (specialist)
#
# The `role` field specifies WHICH agent identity speaks for each position.
# Basic roles (wind-agent, wall-agent, door-agent) use generic cognition.
# Specialist roles (ideator, edge-optimizer, critical-engineer, etc.) bring
# domain expertise on top of their cognition mode.
#
# See agents/README.md for the full three-layer identity model explanation.

# =============================================================================
# STANDARD TIERS (OpenRouter) - Ready to use with API key
# =============================================================================

standard:
  wind:
    provider: openrouter
    model: anthropic/claude-opus-4.8
    role: ideator
  wall:
    provider: openrouter
    model: google/gemini-3.1-pro-preview
    role: validator
  door:
    provider: openrouter
    model: openai/gpt-5.5
    role: synthesizer
  settings:
    consensus_required: true
    max_turns: 12
    max_refinement_loops: 3
    provider_timeout: 300
    show_token_counts: true  # Show token counts per turn in VTP transcript (default: true, opt-out with false)
    # RFC-0001 path_contract Wind learning loop (§6 step 4, §11.2 row 6).
    # Default: false. The A/B treatment build sets this to true; the control
    # build keeps it false. Production code MUST NOT read this directly —
    # access via debate_hall_mcp.features.is_enabled("path_contract", ctx).
    # path_contract_enabled: false
    fallback:
      enabled: true
      provider: openrouter
      model: anthropic/claude-sonnet-4.6
      timeout: 60

fast:
  wind:
    provider: openrouter
    model: anthropic/claude-haiku-4.5
    role: wind-agent
    timeout: 60
  wall:
    provider: openrouter
    model: openai/gpt-5.4-mini
    role: wall-agent
    timeout: 60
  door:
    provider: openrouter
    model: google/gemini-3-flash-preview
    role: door-agent
    timeout: 60
  settings:
    consensus_required: false
    max_turns: 6
    max_refinement_loops: 1
    provider_timeout: 60
    show_token_counts: true  # Show token counts per turn in VTP transcript (default: true, opt-out with false)
    fallback:
      enabled: false

premium:
  wind:
    provider: openrouter
    model: ~anthropic/claude-opus-latest
    role: edge-optimizer
  wall:
    provider: openrouter
    model: openai/gpt-5.5
    role: critical-engineer
  door:
    provider: openrouter
    model: google/gemini-3.1-pro-preview
    role: technical-architect
  settings:
    consensus_required: true
    max_turns: 16
    max_refinement_loops: 5
    provider_timeout: 600
    show_token_counts: true  # Show token counts per turn in VTP transcript (default: true, opt-out with false)
    fallback:
      enabled: true
      provider: openrouter
      model: anthropic/claude-sonnet-4.6
      timeout: 120

