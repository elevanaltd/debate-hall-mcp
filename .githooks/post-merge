#!/usr/bin/env sh
set -eu

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ]; then
  exit 0
fi

BOOTSTRAP="$ROOT/scripts/dev-bootstrap.sh"
VENV_DIR="${VENV_DIR:-.venv}"

if [ ! -f "$BOOTSTRAP" ]; then
  exit 0
fi

if [ -x "$ROOT/$VENV_DIR/bin/python" ]; then
  exit 0
fi

if [ "${DEBATE_HALL_AUTO_BOOTSTRAP:-0}" = "1" ]; then
  QUIET=1 VENV_DIR="$VENV_DIR" "$BOOTSTRAP" || exit 1
  exit 0
fi

printf "%s\n" "debate-hall-mcp: missing $VENV_DIR; run: scripts/dev-bootstrap.sh (or set DEBATE_HALL_AUTO_BOOTSTRAP=1)"

